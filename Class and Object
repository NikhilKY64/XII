class calculator:
    num1 = None
    num2 = None
    
    def sum(self):
        return self.num1 + self.num2
        
    def sub(self):
        return self.num1 - self.num2
        
    def product(self):
        return self.num1 * self.num2
        
    def div(self):
        return self.num1 / self.num2
        
        
        
